# Keep the pick GitHub repo cache fresh so the clone tier never goes stale.
# Fires ~2min after the user manager starts (early in the session) and then
# every 30min. Persistent catches up a missed run on the next start. The
# token only resolves while your keyring/agent is unlocked, so a fire
# during a locked window just no-ops (keep-last-good) and the next tick
# retries, see pick-repos-refresh.sh.
[Unit]
Description=Periodically refresh the pick GitHub repo cache

[Timer]
OnStartupSec=2min
OnUnitActiveSec=30min
Persistent=true

[Install]
WantedBy=timers.target
